{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    // Explicit because TypeScript 7 requires it: without it, tsc stops with
    // TS5011 rather than inferring "src" as it used to. One line, and it
    // means the same thing under 5 and 7.
    "rootDir": "src",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
